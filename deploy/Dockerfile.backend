# image เดียวสำหรับ api และ worker
# stage runtime = Python + library ทั้งหมดจาก lock (ส่วนที่มีผลต่อตัวเลข) ตรึง reference Linux จาก stage นี้
FROM python:3.11.15-slim@sha256:90744cff8f32887f075c47d747a173ff333e9e98801667af93c357fa9f5e28ff AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONHASHSEED=0 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
COPY backend/requirements.lock /tmp/requirements.lock
RUN pip install --only-binary=:all: --no-deps -r /tmp/requirements.lock && pip check && rm /tmp/requirements.lock

# stage app = runtime + โค้ด backend (ไม่มีค่าลับ ไม่มีข้อมูลชีต) รันด้วยผู้ใช้ที่ไม่ใช่ root
FROM runtime AS app
RUN useradd --system --uid 10001 --home-dir /app --shell /usr/sbin/nologin tfp
WORKDIR /app
COPY --chown=root:root backend/app /app/app
COPY --chown=root:root backend/migrations /app/migrations
ENV PYTHONPATH=/app PYTHONUNBUFFERED=1
USER tfp
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2", "--no-server-header"]
